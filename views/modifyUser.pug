extends layout

block main
  h1 #{__i('Modify User "%s"', u.login)}

  form(method="post", action=basepath + "/modifyUser/" + u.uid)
    input(type="hidden", name="_csrf", value=csrfToken)
    p
      label #{__i('Name')}:
      input(name="name", value=u.name)
    p
      label #{__i('Admin')}:
      input(type="checkbox", name="admin", value="t", checked=u.admin)
    p
      h2 #{__i('Folder ACL')}
      if (folders)
        table
          tr
            th #{__i('Folder')}
            th #{__i('Access')}
          each folder in folders
            tr
              td= folder.name
              td
                //- these were plain `var`/`if` lines before, which pug parses
                //- as tags rather than code, so the box never came back checked
                //- and saving the form silently dropped the user's whole ACL
                input(type="checkbox", name="acl[]", value=folder.id, checked=(u.acl && u.acl.indexOf(folder.id) >= 0))
    p
      input(type="submit", value=__i('Modify'))
      input(type="hidden", name="login", value=u.login)
