extends layout

block main
  h1 #{__i('Link with your mobile SparkleShare device')}

  script(type="text/javascript", src=basepath + "/javascripts/qrcode.js")
  script(type="text/javascript", src=basepath + "/javascripts/qrcanvas.js")

  p
    strong #{__i('URL:')}
    | #{url}

  p
    strong #{__i('Link code:')} 
    span#linkcode

  #qrpart
    #qrborder
      #linkqr

    p
      | #{__i('New code will be generated in')}
      span#timeleft 0
      | #{__i('seconds')}.

  script(type="text/javascript", nonce=cspNonce).
    (function () {
      var codeUrl = "#{basepath}/getLinkCode";
      var throbberUrl = "#{basepath}/images/throbber.gif";
      var csrfToken = "#{csrfToken}";

      var qr, codeEl, timeEl;
      var updating = false;
      var validLeft = 0;

      function empty(el) {
        while (el.firstChild) {
          el.removeChild(el.firstChild);
        }
      }

      function updateQr() {
        if (updating) {
          return;
        }
        updating = true;

        empty(qr);
        var throbber = document.createElement('img');
        throbber.src = throbberUrl;
        throbber.alt = 'loading';
        qr.appendChild(throbber);
        codeEl.textContent = '-----';
        timeEl.textContent = '?';

        //the token goes in a header so the request needs no body; middleware
        //accepts either
        fetch(codeUrl, {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrfToken },
          credentials: 'same-origin'
        }).then(function (response) {
          if (!response.ok) {
            throw new Error('could not get a link code: ' + response.status);
          }
          return response.json();
        }).then(function (data) {
          empty(qr);
          codeEl.textContent = data.code;
          timeEl.textContent = data.validFor;
          append_qrcode(4, 'linkqr', 'SSHARE:' + data.url + '#' + data.code);
          validLeft = data.validFor;
          updating = false;
        }).catch(function (error) {
          empty(qr);
          codeEl.textContent = '-----';
          timeEl.textContent = '?';
          //leave validLeft at 0 so the next tick retries
          updating = false;
          console.error(error);
        });
      }

      function tick() {
        if (validLeft <= 1) {
          updateQr();
        } else {
          validLeft -= 1;
          timeEl.textContent = validLeft;
        }
      }

      ui.ready(function () {
        qr = ui.byId('linkqr');
        codeEl = ui.byId('linkcode');
        timeEl = ui.byId('timeleft');
        if (!qr || !codeEl || !timeEl) {
          return;
        }
        tick();
        setInterval(tick, 1000);
      });
    })();
